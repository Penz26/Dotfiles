{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
        "hyprland/workspaces",
        "custom/arrow-right#workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-center": [
        "sway/scratchpad",
        "custom/arrow-left#day",
        "clock#day",
        "custom/arrow-left#time",
        "clock#time",
        "custom/arrow-right#time",
        "clock#date",
        "custom/arrow-right#date",
        "sway/scratchpad#invisible"
    ],
    "modules-right": [
        "tray",
        "custom/arrow-left#backlight",
        "backlight",
        "custom/arrow-left#network",
        "network",
        "custom/arrow-left#audio",
        "bluetooth",
        "pulseaudio",
        "custom/arrow-left#battery",
        "battery"
    ],

    "fixed-center": true,


//      MODULES CONFIGURATION
//      ---------------------


//-----	LEFT MODULES: -----

    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        }
    },

    "sway/mode": {
        "format": "{}:",
        "tooltip": false
    },

    "sway/window": {
        "format": {},
        "max-length": 45,
        "tooltip": false,
        "rewrite": {
            "(.*) - Ablaze Floorp": "$1"
        }
    },


//-----	CENTER MODULES: -----

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": true,
        "format-icons": ["󰙏", "󰙏"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "clock#day": {
        "format": "{:%A}",
        "tooltip-format": "Vecka: {:%V}"
    },

    "clock#time": {
        "timezone": "Europe/Stockholm",
        "tooltip-format": "<big>{:%Z %z}</big>\n<small>Swedish time</small>"
    },

    "clock#date": {
        "format": "{:%d-%m-%Y}",
        "tooltip-format": "<big>{calendar}</big>"
    },

    "sway/scratchpad#invisible": {
        "format": "{icon} {count}",
        "show-empty": true,
        "format-icons": ["󰙏", "󰙏"],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },


//-----	RIGHT MODULES: -----

    "tray": {
        "spacing": 8
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": [
//            "", // nf-weather-moon_new
//            "", // nf-weather-moon_alt_waxing_gibbous_6
            "", // ..
            "",
            "",
//            "",
            "", // nf-weather-moon_alt_waxing_gibbous_1
            "", // nf-weather-moon_alt_first_quarter
            "", // nf-weather-moon_alt_waxing_crescent_6
//            "", // ..
            "",
            "",
//            "",
            "", // nf-weather-moon_alt_waxing_crescent_1
            ""  // nf-weather-moon_full
        ],
        "tooltip-format": "{percent}%"
    },

    "network": {
        "format": "{ifname}",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀",
        "format-disabled": "⚠",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ipaddr}",
        "tooltip-format-wifi": "{ipaddr} via {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Not connected",
        "tooltip-format-disabled": "Not abled",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "nm-applet"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "󰖁 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },

    "battery": {
        "format-full": "󰁹",
        "tooltip-format-full": "Full",

        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂"
        ],
        "format": "{icon} {capacity}%",
        "tooltip-format-discharging": "Time to empty: {time}\nCurrently at: {capacity}%",

        "states": {
            "below10": 10,
            "below20": 20,
            "below30": 30,
            "below40": 40,
            "below50": 50,
            "below60": 60,
            "below70": 70,
            "below80": 80,
            "below90": 90,
            "below100": 100
        },
        "format-charging-below10": "󰢟",
        "format-charging-below20": "󰢜",
        "format-charging-below30": "󰂆",
        "format-charging-below40": "󰂇",
        "format-charging-below50": "󰂈",
        "format-charging-below60": "󰢝",
        "format-charging-below70": "󰂉",
        "format-charging-below80": "󰢞",
        "format-charging-below90": "󰂊",
        "format-charging-below100": "󰂋",
        "tooltip-format-charging": "Time to full: {time}\nCurrently at: {capacity}%"
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
                // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager"
    },


//	ARROWS
//	------

    "custom/arrow-right#workspaces": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-right#time": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-right#date": {
        "format": "",
        "tooltip": false
    },

    "custom/arrow-left#day": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-left#time": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-left#backlight": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-left#network": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-left#audio": {
        "format": "",
        "tooltip": false
    },
    "custom/arrow-left#battery": {
        "format": "",
        "tooltip": false
    }
}